print("Exiting chat.") 
break
history.append({"role": "user", "content": prompt}) 
# Get model response
output = llm.create_chat_completion(messages=history) 
reply = output["choices"][0]["message"]["content"] 
history.append({"role": "assistant", "content": reply})
print(f"Assistant: {reply}\n")


